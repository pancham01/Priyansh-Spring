<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->





	<bean name="emp1" class="seekho.spring.model.Employee">

		<property name="id" value="1011" />
		<property name="name" value="Vikas" />
		<property name="gender" value="Male" />
		<property name="address">
			<bean class="seekho.spring.model.Address">
				<property name="city" value="Kanpur" />
				<property name="state" value="UP" />
			</bean>

		</property>

	</bean>




</beans>